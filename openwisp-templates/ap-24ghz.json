{
    "interfaces": [
        {
            "name": "wlan0",
            "type": "wireless",
            "disabled": false,
            "wireless": {
                "radio": "radio0",
                "mode": "access_point",
                "ssid": "{{ wifi_ssid }}",
                "hidden": false,
                "network": [
                    "lan"
                ],
                "encryption": {
                    "protocol": "wpa3_personal",
                    "cipher": "ccmp",
                    "key": "{{ wifi_password }}",
                    "ieee80211w": "2"
                }
            }
        }
    ],
    "radios": [
        {
            "name": "radio0",
            "phy": "phy0",
            "driver": "mac80211",
            "protocol": "802.11n",
            "channel": 1,
            "channel_width": 20,
            "country": "IT",
            "disabled": false,
            "band": "2g"
        }
    ]
}
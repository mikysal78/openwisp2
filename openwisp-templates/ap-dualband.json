{
    "backend": "netjsonconfig.backends.openwrt.OpenWrt",
    "config": {
        "interfaces": [
            {
                "wireless": {
                    "network": [
                        "lan"
                    ],
                    "mode": "access_point",
                    "radio": "radio0",
                    "ssid": "{{ wifi_ssid }}",
                    "hidden": false,
                    "encryption": {
                        "protocol": "{{ wifi_encryption }}",
                        "key": "{{ wifi_password }}",
                        "cipher": "ccmp",
                        "ieee80211w": "{{ wifi_pmf }}"
                    }
                },
                "type": "wireless",
                "name": "wlan0",
                "disabled": false
            },
            {
                "wireless": {
                    "network": [
                        "lan"
                    ],
                    "mode": "access_point",
                    "radio": "radio1",
                    "ssid": "{{ wifi_ssid }}",
                    "hidden": false,
                    "encryption": {
                        "protocol": "{{ wifi_encryption }}",
                        "key": "{{ wifi_password }}",
                        "cipher": "ccmp",
                        "ieee80211w": "{{ wifi_pmf }}"
                    }
                },
                "type": "wireless",
                "name": "wlan1",
                "disabled": false
            }
        ],
        "radios": [
            {
                "protocol": "802.11ax",
                "name": "radio0",
                "phy": "phy0",
                "channel": 1,
                "channel_width": 20,
                "country": "IT",
                "disabled": false,
                "driver": "mac80211",
                "band": "2g"
            },
            {
                "protocol": "802.11ax",
                "name": "radio1",
                "phy": "phy1",
                "channel": 36,
                "channel_width": 80,
                "country": "IT",
                "disabled": false,
                "driver": "mac80211",
                "band": "5g"
            }
        ]
    },
    "default_values": {
        "wifi_ssid": "ninux.org",
        "wifi_password": "CHANGEME",
        "wifi_encryption": "wpa2_personal_mixed",
        "wifi_pmf": "1"
    }
}

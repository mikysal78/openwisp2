    "files": [
      {
        "path": "/etc/nftables.d/20-ninux-antispoof.nft",
        "mode": "0644",
        "contents": "# Anti-spoofing in ingresso dalle WAN (router di confine NINUX, ReginaMargherita116)\n# Incluso da fw4 dentro \"table inet fw4\". Config LOCALE, non gestita da OpenWISP.\n# Scarta i pacchetti che arrivano da Internet (PPPoE e tunnel PPTP Serveperso)\n# con un IP sorgente che può esistere solo DENTRO la rete NINUX.\n# Gira in prerouting a priorità raw: prima del conntrack, del NAT e del forward.\n# Rollback: rm /etc/nftables.d/20-ninux-antispoof.nft && fw4 reload\n\nset ninux_bogon_v4 {\n\ttype ipv4_addr\n\tflags interval\n\telements = {\n\t\t10.0.0.0/8,         # rete NINUX\n\t\t172.16.0.0/12,      # privati (RFC 1918)\n\t\t192.168.0.0/16,     # privati (RFC 1918)\n\t\t127.0.0.0/8,        # loopback\n\t\t{{ confine_public_net }},    # /29 pubblica NINUX (VM, server OpenWISP)\n\t}\n}\n\nset ninux_bogon_v6 {\n\ttype ipv6_addr\n\tflags interval\n\telements = {\n\t\t{{ confine_public6_prefix }},  # prefisso pubblico NINUX\n\t\tfc00::/7,             # ULA (fdd9:5aff:96d4::/64 e prefissi della mesh)\n\t\t::1/128,              # loopback\n\t}\n}\n\nchain ninux_antispoof {\n\ttype filter hook prerouting priority raw; policy accept;\n\tiifname { \"{{ confine_wan_port }}.{{ confine_wan2_vlan }}\", \"pppoe-wan\", \"pptp-servperso\" } ip saddr @ninux_bogon_v4 counter drop comment \"ninux: sorgente IPv4 interna arrivata da una WAN\"\n\tiifname { \"{{ confine_wan_port }}.{{ confine_wan2_vlan }}\", \"pppoe-wan\", \"pptp-servperso\" } ip6 saddr @ninux_bogon_v6 counter drop comment \"ninux: sorgente IPv6 interna arrivata da una WAN\"\n}\n"
      },
      {
        "path": "/etc/iproute2/rt_tables",
        "mode": "0644",
        "contents": "#\n# reserved values\n#\n128\tprelocal\n255\tlocal\n254\tmain\n253\tdefault\n0\tunspec\n130\tservperso\n#\n# local\n#\n#1\tinr.ruhep\n"
      },
      {
        "path": "/root/logs/cstate-limit.sh",
        "mode": "0755",
        "contents": "#!/bin/sh\n# Gemini Lake (J4125): gli stati C profondi causano blocchi completi del sistema.\n# Lascia attivi solo POLL, C1 e C1E.\nfor s in /sys/devices/system/cpu/cpu*/cpuidle/state*; do\n\tcase \"$(cat $s/name)\" in POLL|C1|C1E) ;; *) echo 1 > $s/disable ;; esac\ndone\nlogger -t cstate-limit \"stati C profondi disattivati\"\n"
      },
      {
        "path": "/etc/ppp/options.pptp",
        "mode": "0644",
        "contents": "noipdefault\nnoauth\nnobsdcomp\nnodeflate\nidle 0\n# pppd 2.5: sintassi upstream (equivale a: mppe required,no40,no56,stateless)\n# require-mppe-128  (il server Serveperso non offre MPPE: col firmware precedente il tunnel era gia in chiaro)\n# nomppe-40\nmaxfail 0\n# attesa tra un tentativo e l altro: con maxfail 0 senza holdoff pppd riprova ogni ~3 s e il provider puo bannare\nholdoff 30\n"
      },
      {
        "path": "/etc/rc.local",
        "mode": "0755",
        "contents": "# Put your custom commands here that should be executed once\n# the system init finished. By default this file does nothing.\n\n/usr/sbin/legacy-openwisp-monitoring\ntouch /etc/crontabs/root\n/etc/init.d/cron start\n\n/root/logs/cstate-limit.sh\n# Watchdog WDAT: wdat_wdt si carica dopo l'ultimo tentativo di procd di aprire\n# /dev/watchdog; qui procd lo apre e lo tiene vivo (timeout 30 s, ping ogni 5 s)\n[ -c /dev/watchdog ] && ubus call system watchdog '{\"stop\": false}' >/dev/null\nexit 0\n"
      },
      {
        "path": "/etc/sysupgrade.conf",
        "mode": "0644",
        "contents": "## This file contains files and directories that should\n## be preserved during an upgrade.\n\n# /etc/example.conf\n# /etc/openvpn/\n/root/logs/\n/etc/nftables.d/20-ninux-antispoof.nft\n/etc/ddns/ddns.key\n/usr/lib/ddns/update_nsupdate.sh\n/etc/ppp/options.pptp\n/etc/modules.d/50-wdat-wdt\n/etc/modules-boot.d/50-wdat-wdt\n/etc/hotplug.d/iface/30-netconsole\n"
      },
      {
        "path": "/etc/modules.d/50-wdat-wdt",
        "mode": "0644",
        "contents": "wdat_wdt\n"
      },
      {
        "path": "/etc/hotplug.d/iface/30-netconsole",
        "mode": "0644",
        "contents": "#!/bin/sh\n# netconsole: log del kernel in tempo reale via UDP al server OpenWISP, che li\n# salva in /opt/router-logs/netconsole-<nome del device>/netconsole.log (rsyslog,\n# porta 6666, ammessa dal firewall del server solo da questo router).\n# Serve a vedere cosa scrive il kernel nei secondi prima di un blocco.\n# Si ricarica a ogni ifup della lan: netconsole si lega a br-lan e smette di\n# funzionare se il device viene ricreato. Sul router i parametri vanno passati\n# al caricamento del modulo (niente /sys/kernel/config/netconsole).\n[ \"$ACTION\" = \"ifup\" ] && [ \"$INTERFACE\" = \"lan\" ] || exit 0\n\nSRC_IP={{ confine_lan_ip }}\nDST_IP=10.27.22.18\nDST_PORT=6666\nDST_MAC_FALLBACK=bc:24:11:c2:1f:cb    # ens18 del server OpenWISP\n\n# nome del device da OpenWISP (hostname): solo caratteri sicuri, altrimenti\n# niente userdata\nNODE='{{ name }}'\ncase \"$NODE\" in\n\t\"\" | *[!A-Za-z0-9._-]*) NODE=\"\" ;;\nesac\n\n# Nome del device nei messaggi: formato esteso (\"+\") con l'userdata\n# ninux_node, cosi' il server salva in netconsole-<nome>/ qualunque sia l'IP\n# di uscita. Serve un kernel con NETCONSOLE_DYNAMIC (firmware dalla build\n# #37); senza, i messaggi arrivano lo stesso e il server usa l'IP sorgente.\nnetconsole_userdata() {\n\tcfg=/sys/kernel/config\n\t[ -d \"$cfg/netconsole\" ] || mount -t configfs configfs \"$cfg\" 2>/dev/null\n\tud=\"$cfg/netconsole/cmdline0/userdata\"\n\t[ -d \"$ud\" ] || return 0\n\tmkdir -p \"$ud/ninux_node\" && printf '%s' \"$NODE\" >\"$ud/ninux_node/value\"\n}\n\nping -c 1 -W 2 \"$DST_IP\" >/dev/null 2>&1\nmac=\"$(ip neigh show \"$DST_IP\" dev br-lan 2>/dev/null | awk '/lladdr/ {print $3; exit}')\"\n[ -n \"$mac\" ] || mac=\"$DST_MAC_FALLBACK\"\n\nrmmod netconsole 2>/dev/null\nif insmod netconsole \"netconsole=+6665@$SRC_IP/br-lan,$DST_PORT@$DST_IP/$mac\"; then\n\t[ -z \"$NODE\" ] || netconsole_userdata\n\tlogger -t netconsole \"attivo: br-lan -> $DST_IP:$DST_PORT ($mac)\"\nelse\n\tlogger -t netconsole \"ERRORE: netconsole non attivato verso $DST_IP\"\nfi\nexit 0\n"
      }
    ]
  },

{
    "interfaces": [
        {
            "name": "wlan0",
            "type": "wireless",
            "disabled": false,
            "wireless": {
                "radio": "radio0",
                "mode": "access_point",
                "ssid": "{{ wifi_ssid }}",
                "hidden": false,
                "network": [
                    "lan"
                ],
                "encryption": {
                    "protocol": "{{ wifi_encryption }}",
                    "cipher": "ccmp",
                    "key": "{{ wifi_password }}",
                    "ieee80211w": "{{ wifi_pmf }}"
                }
            }
        },
        {
            "name": "wlan1",
            "type": "wireless",
            "disabled": false,
            "wireless": {
                "radio": "radio1",
                "mode": "access_point",
                "ssid": "{{ wifi_ssid }}",
                "hidden": false,
                "network": [
                    "lan"
                ],
                "encryption": {
                    "protocol": "{{ wifi_encryption }}",
                    "cipher": "ccmp",
                    "key": "{{ wifi_password }}",
                    "ieee80211w": "{{ wifi_pmf }}"
                }
            }
        }
    ],
    "radios": [
        {
            "name": "radio0",
            "phy": "phy0",
            "driver": "mac80211",
            "protocol": "802.11ax",
            "channel": 1,
            "channel_width": 20,
            "country": "IT",
            "disabled": false,
            "band": "2g"
        },
        {
            "name": "radio1",
            "phy": "phy1",
            "driver": "mac80211",
            "protocol": "802.11ax",
            "channel": 36,
            "channel_width": 80,
            "country": "IT",
            "disabled": false,
            "band": "5g"
        }
    ]
}

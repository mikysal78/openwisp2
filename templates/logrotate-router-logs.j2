# {{ ansible_managed }}
# Rotazione dei log dei router NINUX (raccolti da rsyslog).
# NON sta in /etc/logrotate.d: la esegue ogni ora /etc/cron.d/router-logs con
# uno state file proprio, così maxsize interviene entro un'ora e nessun router
# può riempire /opt (dove c'è anche InfluxDB).
{{ router_logs_dir }}/*/*.log {
    daily
    maxsize {{ router_logs_max_size }}
    rotate {{ router_logs_retention_days }}
    compress
    delaycompress
    missingok
    notifempty
    sharedscripts
    postrotate
        /usr/lib/rsyslog/rsyslog-rotate
    endscript
}

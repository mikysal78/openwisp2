#!/bin/sh
# Gestito da OpenWISP: eseguito da openwisp-config dopo ogni applicazione
# della configurazione (/etc/openwisp/post-reload-hook).
# openwisp-config esegue UN SOLO post-reload-hook, quindi qui convivono due
# compiti: (1) garantire la zona firewall delle interfacce OpenWISP e
# (2) installare/ricaricare bird2. netjsonconfig 1.2 non sa rendere la sezione
# firewall, per questo la zona si crea qui via uci invece che nel template.

# --- (1) Firewall -----------------------------------------------------------
# L'interfaccia ZeroTier (owzt<6hex del network id>) e la mesh (br-mesh, 802.11s)
# sono create da OpenWISP e NON stanno in nessuna zona del firewall dell'immagine
# base: cadono nella policy di input REJECT -> Babel non peera (adiacenza
# unidirezionale, metrica infinita), mgmt/LAN irraggiungibili. Le mettiamo in due
# zone dedicate aperte: "VPN" (owzt*, per DEVICE con wildcard perche' il nome
# logico owzt<id> cambia col network id) e "mesh" (br-mesh), con forwarding
# bidirezionale fra VPN, mesh e lan (i client degli AP).
#
# Zone e forwarding si cercano per NOME/CONTENUTO, non per nome di sezione: sul
# router di confine esistevano gia' zone locali identiche (z_vpn, z_mesh,
# fwd_*) e crearne altre con un'altra sezione ha duplicato "VPN" e "mesh" ->
# fw4 rifiuta il ruleset intero e al riavvio il router resta SENZA firewall
# (14/10/2026). Per questo dopo ogni modifica si valida con fw4 check e, se
# fallisce, si torna alla configurazione precedente.

# Sezione uci della zona con questo nome (vuoto se non esiste)
fw_zone_section() {
    for s in $(uci -q show firewall | sed -n 's/^firewall\.\([^.=]*\)=zone$/\1/p'); do
        [ "$(uci -q get "firewall.$s.name")" = "$1" ] && { echo "$s"; return 0; }
    done
    return 1
}

# Esiste gia' un forwarding src -> dest (in qualunque sezione)?
fw_forwarding_exists() {
    for s in $(uci -q show firewall | sed -n 's/^firewall\.\([^.=]*\)=forwarding$/\1/p'); do
        [ "$(uci -q get "firewall.$s.src")" = "$1" ] && \
            [ "$(uci -q get "firewall.$s.dest")" = "$2" ] && return 0
    done
    return 1
}

if command -v uci >/dev/null 2>&1; then
    fw_changed=0
    fw_backup=/tmp/firewall.pre-openwisp-hook
    cp /etc/config/firewall "$fw_backup" 2>/dev/null

    # migrazione: rimuovi la vecchia zona unica "ninux" (versioni precedenti)
    for old in ninux ninux_lan lan_ninux; do
        if [ -n "$(uci -q get firewall.$old)" ]; then
            uci -q delete firewall.$old
            fw_changed=1
        fi
    done

    # zona VPN (interfaccia ZeroTier owzt*, per device wildcard)
    vpn_sec="$(fw_zone_section VPN)"
    if [ -z "$vpn_sec" ]; then
        vpn_sec=vpn
        uci -q set firewall.vpn=zone
        uci -q set firewall.vpn.name='VPN'
        uci -q set firewall.vpn.input='ACCEPT'
        uci -q set firewall.vpn.output='ACCEPT'
        uci -q set firewall.vpn.forward='ACCEPT'
        fw_changed=1
    fi
    if ! uci -q get "firewall.$vpn_sec.device" | grep -qF 'owzt*'; then
        uci -q add_list "firewall.$vpn_sec.device=owzt*"
        fw_changed=1
    fi

    # zona mesh (br-mesh 802.11s)
    mesh_sec="$(fw_zone_section mesh)"
    if [ -z "$mesh_sec" ]; then
        mesh_sec=mesh
        uci -q set firewall.mesh=zone
        uci -q set firewall.mesh.name='mesh'
        uci -q set firewall.mesh.input='ACCEPT'
        uci -q set firewall.mesh.output='ACCEPT'
        uci -q set firewall.mesh.forward='ACCEPT'
        fw_changed=1
    fi
    if ! uci -q get "firewall.$mesh_sec.network" | grep -qw mesh; then
        uci -q add_list "firewall.$mesh_sec.network=mesh"
        fw_changed=1
    fi

    # forwarding bidirezionali fra VPN, mesh e lan
    for fwd in "vpn_lan:VPN:lan" "lan_vpn:lan:VPN" "vpn_mesh:VPN:mesh" \
               "mesh_vpn:mesh:VPN" "mesh_lan:mesh:lan" "lan_mesh:lan:mesh"; do
        sec="${fwd%%:*}"; rest="${fwd#*:}"; src="${rest%%:*}"; dst="${rest##*:}"
        fw_forwarding_exists "$src" "$dst" && continue
        uci -q set firewall.$sec=forwarding
        uci -q set firewall.$sec.src="$src"
        uci -q set firewall.$sec.dest="$dst"
        fw_changed=1
    done

    if [ "$fw_changed" = 1 ]; then
        uci -q commit firewall
        # Mai lasciare una configurazione che fw4 rifiuta: al prossimo avvio il
        # router resterebbe senza firewall e senza NAT.
        if command -v fw4 >/dev/null 2>&1 && ! fw4 -q check >/dev/null 2>&1; then
            cp "$fw_backup" /etc/config/firewall
            logger -t openwisp-fw "ERRORE: la nuova config firewall non passa fw4 check, ripristinata la precedente"
        else
            /etc/init.d/firewall reload >/dev/null 2>&1
            logger -t openwisp-fw "zone firewall VPN(owzt*)/mesh + forwarding applicate"
        fi
    fi
    rm -f "$fw_backup"
fi

# --- (2) bird2 --------------------------------------------------------------
[ -f /etc/bird.conf ] || exit 0

if [ ! -x /etc/init.d/bird ]; then
    logger -t openwisp-bird "bird2 non installato, provo a installarlo"
    if command -v apk >/dev/null 2>&1; then
        apk update >/dev/null 2>&1 && apk add bird2 >/dev/null 2>&1
    elif command -v opkg >/dev/null 2>&1; then
        opkg update >/dev/null 2>&1 && opkg install bird2 >/dev/null 2>&1
    fi
fi

if [ ! -x /etc/init.d/bird ]; then
    logger -t openwisp-bird "bird2 assente e non installabile (router senza uplink?): salto"
    exit 0
fi

# Non ricaricare mai con una configurazione non valida: bird resterebbe giu'
# e il router si taglierebbe fuori dalla rete.
if ! bird -p -c /etc/bird.conf >/dev/null 2>&1; then
    logger -t openwisp-bird "/etc/bird.conf NON valida, bird non ricaricato"
    exit 0
fi

/etc/init.d/bird enable >/dev/null 2>&1

if pgrep -f '/usr/sbin/bird' >/dev/null 2>&1; then
    /etc/init.d/bird reload >/dev/null 2>&1 || /etc/init.d/bird restart >/dev/null 2>&1
    logger -t openwisp-bird "bird ricaricato"
else
    /etc/init.d/bird start >/dev/null 2>&1
    logger -t openwisp-bird "bird avviato"
fi

exit 0

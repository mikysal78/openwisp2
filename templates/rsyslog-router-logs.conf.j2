# {{ ansible_managed }}
# Raccolta centrale dei log dei router NINUX — gestito dal playbook, non modificare a mano
#
# Due ingressi UDP, ciascuno con il proprio ruleset: i messaggi dei router NON
# finiscono in /var/log/syslog del server.
#   {{ router_logs_syslog_port }}/udp  syslog remoto di OpenWrt (logd: system.log_ip) -> <hostname>/syslog.log
#   {{ router_logs_netconsole_port }}/udp netconsole del kernel (testo grezzo, senza header syslog) -> <ip sorgente>/netconsole.log
# Chi può inviare lo decide nftables (solo 10.27.0.0/16).

module(load="imudp")

# Il nome host lo dichiara il router: secpath-replace impedisce che un valore
# con "/" o ".." esca dalla directory dei log.
template(name="RouterSyslogFile" type="string"
         string="{{ router_logs_dir }}/%HOSTNAME:::secpath-replace%/syslog.log")
# netconsole non ha header syslog (niente hostname): si usa l'IP sorgente.
template(name="RouterNetconsoleFile" type="string"
         string="{{ router_logs_dir }}/netconsole-%FROMHOST-IP%/netconsole.log")
# Righe con l'ora di ricezione del server: l'orologio di un router che si sta
# bloccando non è affidabile.
template(name="RouterLine" type="string"
         string="%timegenerated:::date-rfc3339% %HOSTNAME% %syslogtag%%msg:::sp-if-no-1st-sp%%msg:::drop-last-lf%\n")
template(name="RouterRawLine" type="string"
         string="%timegenerated:::date-rfc3339% %rawmsg:::drop-last-lf%\n")

ruleset(name="router-syslog") {
    action(type="omfile" dynaFile="RouterSyslogFile" template="RouterLine"
           dynaFileCacheSize="100" dirCreateMode="0750" fileCreateMode="0640"
           fileOwner="root" fileGroup="adm" dirOwner="root" dirGroup="adm")
    stop
}

ruleset(name="router-netconsole") {
    action(type="omfile" dynaFile="RouterNetconsoleFile" template="RouterRawLine"
           dynaFileCacheSize="20" dirCreateMode="0750" fileCreateMode="0640"
           fileOwner="root" fileGroup="adm" dirOwner="root" dirGroup="adm")
    stop
}

input(type="imudp" port="{{ router_logs_syslog_port }}" ruleset="router-syslog"
      RateLimit.Interval="5" RateLimit.Burst="2000")
# Nessun rate limit su netconsole: un oops o uno stack trace arrivano a raffica
# ed è proprio quello che serve conservare.
input(type="imudp" port="{{ router_logs_netconsole_port }}" ruleset="router-netconsole")

#!/usr/sbin/nft -f
# {{ ansible_managed }}
# Firewall CT OpenWISP — gestito dal playbook, non modificare a mano

flush ruleset

table inet filter {
    chain input {
        type filter hook input priority filter; policy drop;

        iif "lo" accept
        ct state established,related accept
        ct state invalid drop

        ip protocol icmp accept
        meta l4proto ipv6-icmp accept

        tcp dport {{ firewall_ssh_port }} ip saddr { {{ firewall_ssh_sources_v4 | join(', ') }} } accept comment "SSH solo dalla rete di gestione (il traffico mgmt arriva anche instradato dalla mesh, non si filtra per interfaccia)"
        tcp dport { 80, 443 } accept comment "nginx: OpenWISP + WiFi Login Pages"
        udp dport {{ firewall_wg_port }} accept comment "WireGuard"

        tcp dport {{ firewall_webhook_port }} ip saddr { {{ firewall_webhook_sources_v4 | join(', ') }} } accept comment "webhook aggiornamento peer WireGuard"
        tcp dport {{ firewall_webhook_port }} ip6 saddr { {{ firewall_webhook_sources_v6 | join(', ') }} } accept comment "webhook aggiornamento peer WireGuard (IPv6)"

        udp dport { 1812, 1813 } ip saddr { {{ firewall_radius_sources_v4 | join(', ') }} } accept comment "FreeRADIUS (solo VPN e rete di gestione)"

{% for iface in firewall_babel_interfaces %}
        iifname "{{ iface }}" udp dport 6696 accept comment "Babel (bird2)"
{% endfor %}

        iifname "{{ firewall_wg_interface }}" udp dport 4789 accept comment "VXLAN incapsulato nel tunnel WireGuard"
    }

    chain forward {
        type filter hook forward priority filter; policy drop;

        ct state established,related accept
        # I router si vedono tra loro attraverso l'hub; OpenWISP NON fa da
        # gateway: nessun forward verso {{ firewall_wan_interface }} e nessun NAT
        iifname "{{ firewall_wg_interface }}" oifname "{{ firewall_wg_interface }}" accept comment "traffico router-router via VPN (IP dei tunnel)"
        iifname "vxlan*" oifname "vxlan*" accept comment "traffico router-router instradato tra i segmenti VXLAN"
    }
}
